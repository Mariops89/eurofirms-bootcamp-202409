{
  "name": "api-ts",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "start": "npx tsx --env-file=.env index.ts",
    "inspect": "npx tsx --inspect-brk index.ts",
    "compile": "npm run clean && npx tsc",
    "compile-watch": "bash -c 'npx tsc --watch'",
    "test": "mocha --node-option \"env-file=.env\" --node-option \"import=tsx\" logic/*.spec.ts",
    "test-inspect": "mocha --node-option 'env-file=.env' --node-option 'import=tsx' --node-option 'inspect-brk' logic/*.spec.ts",
    "compile-test": "npm run compile && npm run test",
    "populate": "bash -c 'npx tsx data/populate.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.0",
    "mocha": "^11.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "com": "file:../com",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "zod": "^4.1.12"
  }
}